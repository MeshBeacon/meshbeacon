FROM jkaninda/laravel-php-fpm:8.4
# Modify file before COPY
RUN sed -i 's/memory_limit = 256M/memory_limit = 4096M/g' /usr/local/etc/php/conf.d/php.ini \
    && echo "upload_max_filesize = 500M" >> /usr/local/etc/php/conf.d/php.ini \
    && echo "post_max_size = 500M" >> /usr/local/etc/php/conf.d/php.ini
# Copy Laravel project files
COPY . /var/www/html
COPY ./supervisor/* /etc/supervisor/conf.d/
VOLUME /var/www/html/storage
# Now we set root / at /var/www/html
WORKDIR /var/www/html
RUN chmod +x services/docker/worker-entrypoint.sh

#RUN mkdir -p /var/www/html/storage/framework/{cache,sessions,views}
#RUN chmod -R 777 /var/www/html/storage
#RUN php artisan config:clear && php artisan cache:clear && php artisan view:clear

# Run command at WORKDIR
# Nginx's generated config serves *.js/*.css as static files with no
# fallback to PHP, so Flux's dynamically-routed script (normally served
# via the /flux/flux.js Laravel route) 404s in production. Symlink it to
# a real static path (nginx's own image has the equivalent symlinks for
# both Livewire and Flux, see Dockerfile.nginx).
RUN mkdir -p public/flux && \
    ln -s ../../vendor/livewire/flux/dist/flux-lite.min.js public/flux/flux.js && \
    ln -s ../../vendor/livewire/flux/dist/flux-lite.min.js public/flux/flux.min.js
# Build assets
#RUN apt-get update
#RUN apt-get install -y nodejs
#RUN npm run build

EXPOSE 9000
# Fix permissions
RUN chown -R www-data:www-data /var/www/html

USER www-data
