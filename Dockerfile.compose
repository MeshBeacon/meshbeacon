# syntax=docker/dockerfile:1.7

# Install PHP dependencies in a separate stage so the production image does
# not need Composer. A BuildKit secret can provide Composer authentication for
# proprietary packages such as Livewire Flux without baking credentials into a
# layer.
FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN --mount=type=secret,id=composer_auth,required=false \
    if [ -f /run/secrets/composer_auth ]; then export COMPOSER_AUTH="$(cat /run/secrets/composer_auth)"; fi; \
    composer install \
        --no-dev \
        --no-interaction \
        --no-progress \
        --no-scripts \
        --prefer-dist \
        --optimize-autoloader

# Vite needs the Flux package's CSS during the Tailwind build, so copy the
# completed vendor tree into the asset-builder stage.
FROM node:22-alpine AS assets
WORKDIR /app
COPY package*.json ./
RUN if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi
COPY --from=vendor /app/vendor ./vendor
COPY resources ./resources
COPY vite.config.js ./
RUN npm run build

FROM php:8.4-fpm-alpine AS app

RUN apk add --no-cache \
        curl \
        icu-libs \
        libxml2 \
        libzip \
        oniguruma \
        sqlite-libs \
    && apk add --no-cache --virtual .build-deps \
        $PHPIZE_DEPS \
        curl-dev \
        icu-dev \
        libxml2-dev \
        libzip-dev \
        oniguruma-dev \
        sqlite-dev \
    && docker-php-ext-install -j"$(nproc)" \
        bcmath \
        curl \
        intl \
        mbstring \
        pcntl \
        pdo_mysql \
        pdo_sqlite \
        xml \
        zip \
    && apk del .build-deps

WORKDIR /var/www
COPY . .
COPY --from=vendor /app/vendor ./vendor
COPY --from=assets /app/public/build ./public/build

# Recreate Laravel's package manifest and publish package assets after the
# application source and vendor tree are both present. Runtime configuration
# is intentionally not cached because each deployment has its own .env.
RUN php artisan package:discover --ansi \
    && php artisan vendor:publish --tag=laravel-assets --ansi --force \
    && mkdir -p public/flux \
    && ln -sf ../../vendor/livewire/flux/dist/flux-lite.min.js public/flux/flux.js \
    && ln -sf ../../vendor/livewire/flux/dist/flux-lite.min.js public/flux/flux.min.js \
    && chmod +x services/docker/worker-entrypoint.sh \
    && chown -R www-data:www-data /var/www/storage /var/www/bootstrap/cache /var/www/database

USER www-data

EXPOSE 9000
CMD ["php-fpm"]
