APP_NAME=MeshBeacon
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Container image source and host ports used by docker compose
# Set MESHBEACON_IMAGE_SOURCE=ghcr to pull the published multi-architecture image.
MESHBEACON_IMAGE_SOURCE=local
MESHBEACON_IMAGE=meshbeacon:local
MESHBEACON_GHCR_IMAGE=ghcr.io/9m2pju/meshbeacon:latest
MESHBEACON_PORT=8080
MQTT_BIND_ADDRESS=0.0.0.0
MQTT_BIND_PORT=1883

# How often Docker polls the app/worker healthchecks (each poll boots a short
# PHP CLI process). Defaults suit an always-on server. On constrained field
# hardware (e.g. Raspberry Pi), raise these (e.g. 30s-60s) to cut CPU/memory
# churn - the underlying heartbeat TTLs already tolerate slower detection.
# MESHBEACON_HC_INTERVAL=10s
# MESHBEACON_WORKER_HC_INTERVAL=15s

# A new install must provide a strong password for the first administrator.
# The installer generates one when this value is empty.
MESHBEACON_ADMIN_EMAIL=admin@example.com
MESHBEACON_ADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Hybrid Deployment — Store-and-Forward Sync
# ---------------------------------------------------------------------------
# Leave both values empty (or remove them) when:
#   - This instance IS the central/production server (MySQL/PostgreSQL)
#   - This instance is a fully offline standalone field node
#
# Set both values when running as a field node (SQLite) that should sync
# records to a central DMS instance whenever internet is available.
# ---------------------------------------------------------------------------
CENTRAL_DMS_URL=
CENTRAL_DMS_TOKEN=
DASHBOARD_READONLY=false

# ---------------------------------------------------------------------------
# Telegram Bot — SOS alerting (free alternative to WhatsApp/SMS)
# ---------------------------------------------------------------------------
# Create a bot via @BotFather to get TELEGRAM_BOT_TOKEN + TELEGRAM_BOT_USERNAME.
# TELEGRAM_WEBHOOK_SECRET is any random string you choose — run
# `php artisan telegram:set-webhook` after setting all three to register it.
# Leave TELEGRAM_BOT_TOKEN empty to disable Telegram alerting entirely.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# TAK CoT Bridge — see docs/TAK_BRIDGE.md
# ---------------------------------------------------------------------------
# The bridge that forwards Duck GPS events to ATAK/WinTAK/OpenTAKServer runs
# as its own standalone service (separate docker-compose.yml, with its own
# TAK_IP/TAK_PORT settings) — it is not configured here. This flag only
# controls whether the "TAK Logs" nav link is shown in this app, so leave it
# false until that bridge service is actually deployed and forwarding events
# to the `hub/tak/log` MQTT topic.
# ---------------------------------------------------------------------------
TAK_BRIDGE_ENABLED=false

# ---------------------------------------------------------------------------
# Duck Crypto — mesh end-to-end encryption (see docs/crypto-design.tex in
# meshbeacon-firmware)
# ---------------------------------------------------------------------------
# This OpenDMS instance's fixed, static X25519 keypair, raw 32-byte keys.
# DUCK_CRYPTO_PUBLIC_KEY is hex (64 chars) -- matches
# meshbeacon-firmware's OPENDMS_STATIC_PUBLIC_KEY_HEX build flag exactly, so
# this value can be pasted straight into both places with no re-encoding.
# DUCK_CRYPTO_PRIVATE_KEY stays base64 -- it's only ever consumed by this
# app's own PHP code (never sent to a Duck or compiled into firmware), so
# there's no interop reason to change it.
# Back up the private key normally (.env/secrets manager) -- this is the
# one deliberate exception to the field-device "no key backup" rule, since
# losing it without a backup requires re-flashing every already-fielded
# device with a new public key.
# Leave both empty to disable encryption entirely (SendSosAck etc. fall back
# to their existing unencrypted behavior).
# ---------------------------------------------------------------------------
DUCK_CRYPTO_PRIVATE_KEY=
DUCK_CRYPTO_PUBLIC_KEY=

# This deployment's pre-shared mesh group symmetric key (see
# meshbeacon-firmware's src/security/MeshGroupConfig.h), hex (64 chars) --
# matches the MESH_GROUP_KEY_HEX build flag exactly. Unlike the OpenDMS
# keypair above, this key IS secret -- back it up like any other shared
# secret, not like the OpenDMS private key (which is unique per-deployment
# and never distributed to Ducks). Used to authenticate the "Emergency
# broadcast" feature (StatusController::broadcast()), since encrypted_cmd
# can't address a broadcast. Leave empty to send broadcasts in the clear.
DUCK_MESH_GROUP_KEY=

# ---------------------------------------------------------------------------
# OpenTAKServer Encrypted Bridge — see docs/OPENTAK_BRIDGE.md
# ---------------------------------------------------------------------------
# Distinct X25519 keypair from DUCK_CRYPTO_* above -- this one authenticates
# the MeshBeacon <-> OpenTAKServer plugin MQTT link specifically. Generate
# with: php artisan opentak:keygen
#
# OPENTAK_BRIDGE_PUBLIC_KEY is hex (64 chars) -- paste this verbatim into the
# OTS plugin's OTS_MESHBEACON_PEER_PUBLIC_KEY setting. OPENTAK_BRIDGE_PRIVATE_KEY
# stays base64 and must never leave this server.
# OPENTAK_SERVER_PUBLIC_KEY is the OTS plugin's own static public key (hex,
# 64 chars), copied from the plugin's setup output on the OpenTAKServer side.
#
# Leave OPENTAK_BRIDGE_ENABLED=false until both sides have exchanged public
# keys -- ProcessMqttMessage will not publish telemetry and incoming
# commands are ignored while disabled or unconfigured.
# ---------------------------------------------------------------------------
OPENTAK_BRIDGE_ENABLED=false
OPENTAK_BRIDGE_PRIVATE_KEY=
OPENTAK_BRIDGE_PUBLIC_KEY=
OPENTAK_SERVER_PUBLIC_KEY=
OPENTAK_EVENT_TOPIC=hub/opentak/event
OPENTAK_COMMAND_TOPIC=hub/opentak/command

# MQTT server
MQTT_HOST=
MQTT_PORT=1883
