APP_NAME=MeshBeacon
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Container image source and host ports used by docker compose
# Set MESHBEACON_IMAGE_SOURCE=ghcr to pull the published multi-architecture image.
MESHBEACON_IMAGE_SOURCE=local
MESHBEACON_IMAGE=meshbeacon:local
MESHBEACON_GHCR_IMAGE=ghcr.io/9m2pju/meshbeacon:latest
MESHBEACON_PORT=8080
MQTT_BIND_ADDRESS=0.0.0.0
MQTT_BIND_PORT=1883

# How often Docker polls the app/worker healthchecks (each poll boots a short
# PHP CLI process). Defaults suit an always-on server. On constrained field
# hardware (e.g. Raspberry Pi), raise these (e.g. 30s-60s) to cut CPU/memory
# churn - the underlying heartbeat TTLs already tolerate slower detection.
# MESHBEACON_HC_INTERVAL=10s
# MESHBEACON_WORKER_HC_INTERVAL=15s

# A new install must provide a strong password for the first administrator.
# The installer generates one when this value is empty.
MESHBEACON_ADMIN_EMAIL=admin@example.com
MESHBEACON_ADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Hybrid Deployment — Store-and-Forward Sync
# ---------------------------------------------------------------------------
# Leave both values empty (or remove them) when:
#   - This instance IS the central/production server (MySQL/PostgreSQL)
#   - This instance is a fully offline standalone field node
#
# Set both values when running as a field node (SQLite) that should sync
# records to a central DMS instance whenever internet is available.
# ---------------------------------------------------------------------------
CENTRAL_DMS_URL=
CENTRAL_DMS_TOKEN=
DASHBOARD_READONLY=false

# ---------------------------------------------------------------------------
# Telegram Bot — SOS alerting (free alternative to WhatsApp/SMS)
# ---------------------------------------------------------------------------
# Create a bot via @BotFather to get TELEGRAM_BOT_TOKEN + TELEGRAM_BOT_USERNAME.
# TELEGRAM_WEBHOOK_SECRET is any random string you choose — run
# `php artisan telegram:set-webhook` after setting all three to register it.
# Leave TELEGRAM_BOT_TOKEN empty to disable Telegram alerting entirely.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Duck Crypto — mesh end-to-end encryption (see docs/crypto-design.tex in
# meshbeacon-firmware)
# ---------------------------------------------------------------------------
# This OpenDMS instance's fixed, static X25519 keypair, base64-encoded raw
# 32-byte keys. The public half gets pinned into every Duck's firmware at
# flash time; back up the private half normally (.env/secrets manager) --
# this is the one deliberate exception to the field-device "no key backup"
# rule, since losing it without a backup requires re-flashing every already
# -fielded device with a new public key.
# Leave both empty to disable encryption entirely (SendSosAck etc. fall back
# to their existing unencrypted behavior).
# ---------------------------------------------------------------------------
DUCK_CRYPTO_PRIVATE_KEY=
DUCK_CRYPTO_PUBLIC_KEY=

# MQTT server
MQTT_HOST=
MQTT_PORT=1883
